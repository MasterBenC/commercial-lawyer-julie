{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "commercial-lawyer-julie/run-metadata.schema.json",
  "title": "Julie risk-tiered normalized run metadata index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactSetAsOfUtc",
    "sourceManifest",
    "normalizationPolicy",
    "runs"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "artifactSetAsOfUtc": { "type": "string", "format": "date-time" },
    "sourceManifest": { "type": "string", "minLength": 1 },
    "normalizationPolicy": { "type": "string", "minLength": 1 },
    "runs": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": { "$ref": "#/$defs/run" }
    }
  },
  "$defs": {
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "scenarioId",
        "startedAtUtc",
        "modelIdentifierAndVersion",
        "skillCommitSha",
        "skillSha256",
        "actualMode",
        "actualRoutes",
        "actualRisk",
        "escalationDecision",
        "escalationReasons",
        "sourceState",
        "decisiveQuestionCount",
        "hostRuntimeVersion",
        "systemDeveloperInstructionsDigest",
        "enabledToolsAndVersions",
        "permissionProfile",
        "samplingParameters",
        "seedOrUnavailable",
        "rawArtifactPath",
        "rawArtifactSha256",
        "completeUneditedAnswerSha256",
        "completeUneditedAnswerByteLength"
      ],
      "properties": {
        "runId": { "type": "string", "pattern": "^(?:S0[1-8]|A0[1-6])-run[12]$" },
        "scenarioId": { "type": "string", "pattern": "^(?:S0[1-8]|A0[1-6])$" },
        "startedAtUtc": { "type": "string", "format": "date-time" },
        "modelIdentifierAndVersion": { "type": "string", "minLength": 1 },
        "skillCommitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "skillSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
        "actualMode": { "enum": ["quick_qa", "document_review", "lifecycle_guidance"] },
        "actualRoutes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "deals_contracts",
              "ai_data_ip",
              "delivery_change_acceptance",
              "invoicing_collections",
              "disputes_evidence",
              "lawyer_handoff"
            ]
          }
        },
        "actualRisk": { "enum": ["low", "medium", "high"] },
        "escalationDecision": { "enum": ["triggered", "not_triggered"] },
        "escalationReasons": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "sourceState": { "type": "string", "minLength": 1 },
        "decisiveQuestionCount": { "type": "integer", "minimum": 0 },
        "hostRuntimeVersion": { "type": "string", "minLength": 1 },
        "systemDeveloperInstructionsDigest": { "type": "string", "minLength": 1 },
        "enabledToolsAndVersions": { "type": "string", "minLength": 1 },
        "permissionProfile": { "type": "string", "minLength": 1 },
        "samplingParameters": { "type": "string", "minLength": 1 },
        "seedOrUnavailable": { "type": "string", "minLength": 1 },
        "rawArtifactPath": { "type": "string", "pattern": "^work/risk-tiered-evaluation/runs/.+\\.md$" },
        "rawArtifactSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
        "completeUneditedAnswerSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
        "completeUneditedAnswerByteLength": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "x-runContract": {
    "scenarioCount": 14,
    "defaultRunsPerScenario": 1,
    "criticalScenarioRuns": { "A02": 2, "S03": 2, "S06": 2, "S08": 2 },
    "expectedTotalRuns": 18,
    "criticalPairConsistencyFields": ["actualRisk", "escalationDecision"]
  }
}
